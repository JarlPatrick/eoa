# Required: Root password for MariaDB
MYSQL_ROOT_PASSWORD=

# Required: Password for the 'eoamanager' database user
MYSQL_PASSWORD=

# Optional: Port to expose the Next.js site on host (default: 8080)
WEB_PORT=

# Optional: Port to expose MariaDB service on host (default: 3306)
DB_PORT=

# Required: stable random secret (at least 32 characters) for public UUID links.
# Changing it invalidates existing public links.
PUBLIC_ID_SECRET=
